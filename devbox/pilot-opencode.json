{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "{env:OPENCODE_MODEL}",
  "default_agent": "pilot",
  "agents": {
    "pilot": {
      "mode": "primary",
      "steps": 32,
      "system": "Implement the requested maintenance change in this checkout. Edit files only. Do not commit, push, open pull requests, deploy, access live FIFA services, or develop exploits. Stop and report blockers. A separate worker verifies the patch.",
      "permissions": [
        {"action": "*", "resource": "*", "effect": "deny"},
        {"action": "read", "resource": "*", "effect": "allow"},
        {"action": "glob", "resource": "*", "effect": "allow"},
        {"action": "grep", "resource": "*", "effect": "allow"},
        {"action": "edit", "resource": "*", "effect": "allow"}
      ]
    }
  },
  "policies": [
    {"action": "plugin.use", "resource": "*", "effect": "deny"},
    {"action": "mcp.use", "resource": "*", "effect": "deny"}
  ]
}
