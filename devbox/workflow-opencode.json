{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "{env:OPENCODE_MODEL}",
  "default_agent": "maintenance",
  "agents": {
    "maintenance": {
      "mode": "primary",
      "steps": 32,
      "system": "Implement ordinary software maintenance in this checkout. Edit files only. Do not commit, push, open pull requests, deploy, target live services, or develop or reproduce exploits. Stop and report blockers. A separate worker verifies the patch.",
      "permissions": [
        {"action": "*", "resource": "*", "effect": "deny"},
        {"action": "read", "resource": "*", "effect": "allow"},
        {"action": "glob", "resource": "*", "effect": "allow"},
        {"action": "grep", "resource": "*", "effect": "allow"},
        {"action": "edit", "resource": "*", "effect": "allow"}
      ]
    }
  },
  "policies": [
    {"action": "tool.use", "resource": "*", "effect": "deny"},
    {"action": "tool.use", "resource": "read:*", "effect": "allow"},
    {"action": "tool.use", "resource": "glob:*", "effect": "allow"},
    {"action": "tool.use", "resource": "grep:*", "effect": "allow"},
    {"action": "tool.use", "resource": "edit:*", "effect": "allow"},
    {"action": "plugin.use", "resource": "*", "effect": "deny"},
    {"action": "mcp.use", "resource": "*", "effect": "deny"}
  ]
}
